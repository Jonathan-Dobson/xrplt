{
  "name": "xrplt",
  "version": "0.6.1",
  "description": "A standalone, zero-dependency transaction builder for the XRP Ledger",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-vm-modules node_modules/.bin/vitest run tests/transaction.test.ts",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/vitest",
    "test:integration:offline": "node --experimental-vm-modules node_modules/.bin/vitest run tests/integration.offline.test.ts",
    "test:integration:testnet": "node --experimental-vm-modules node_modules/.bin/vitest run tests/integration.testnet.test.ts --testTimeout=30000",
    "test:docs": "node --experimental-vm-modules node_modules/.bin/vitest run tests/docs.test.ts",
    "test:all": "npm run test && npm run test:integration:offline && npm run test:integration:testnet",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run lint && npm run build"
  },
  "keywords": [
    "xrp",
    "xrpl",
    "transaction",
    "builder",
    "ripple",
    "ledger",
    "blockchain",
    "crypto"
  ],
  "author": "Jonathan Dobson",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^25.6.2",
    "codebase-semantic-search": "^0.2.5",
    "eslint": "^9.39.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.1",
    "xrpl": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jonathan-Dobson/xrplt.git"
  },
  "bugs": {
    "url": "https://github.com/Jonathan-Dobson/xrplt/issues"
  },
  "homepage": "https://github.com/Jonathan-Dobson/xrplt#readme",
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.5": true
  }
}
